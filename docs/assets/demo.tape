# VHS tape — record a short MCP demo for the README.
# From repo root: vhs docs/assets/demo.tape

Output docs/assets/demo.gif

Set Shell zsh
Set FontSize 16
Set Width 980
Set Height 520
Set Theme "Catppuccin Mocha"
Set TypingSpeed 32ms
Set PlaybackSpeed 1.05
Set Padding 18

Type "./scripts/demo.sh"
Enter
Sleep 7s
